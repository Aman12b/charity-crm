# Copy to .env and adjust. Never commit .env.

# Database
POSTGRES_DB=charitycrm
POSTGRES_USER=charitycrm
POSTGRES_PASSWORD=change-me-db-password

# Initial admin (created on first start, must change password on first login)
SEED_ADMIN_EMAIL=admin@charity.local
SEED_ADMIN_PASSWORD=ChangeMe12345

# Ports
WEB_PORT=8080
MAILPIT_UI_PORT=8025

# Mail – default: Mailpit (captures all mails, nothing is really sent)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=false
SMTP_FROM_ADDRESS=noreply@charity.local
SMTP_FROM_NAME=Charity CRM

# Real provider example (Brevo / Mailjet etc.):
# SMTP_HOST=smtp-relay.example.com
# SMTP_PORT=587
# SMTP_USERNAME=...
# SMTP_PASSWORD=...
# SMTP_USE_STARTTLS=true
# SMTP_FROM_ADDRESS=verified-sender@yourdomain.at

# Set to true when served over HTTPS
AUTH_COOKIE_SECURE=false

ASPNETCORE_ENVIRONMENT=Production
LOG_LEVEL=Information
